<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_band_alert_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_22sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imgDirection"
            android:layout_width="0dp"
            android:layout_height="@dimen/_13sdp"
            android:layout_weight="1"
            android:contentDescription="@string/band_alert_icon"
            android:layout_marginStart="@dimen/_7sdp"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/red"
            android:id="@+id/textAlertType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="MRCD"
            android:layout_weight="3.5"
            android:textAlignment="center"/>
        <ImageView
            android:id="@+id/imgBandRSSILevel"
            android:layout_width="0dp"
            android:layout_height="@dimen/_13sdp"
            android:scaleType="fitXY"
            android:layout_weight="0.7"
            android:contentDescription="@string/image_band_level"
            android:layout_marginEnd="@dimen/_5sdp"/>
        <View
            android:background="#35373c"
            android:layout_width="@dimen/_1sdp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_1sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_1sdp"
            android:layout_marginVertical="@dimen/_5sdp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
