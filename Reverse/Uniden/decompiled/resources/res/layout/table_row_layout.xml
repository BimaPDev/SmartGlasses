<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TableLayout
        android:id="@+id/table_heading_layout"
        android:background="@color/low_grey"
        android:paddingBottom="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvElement"
                android:background="@color/black"
                android:layout_width="0dp"
                android:layout_column="0"
                android:text="UI"
                android:layout_weight="1"
                android:textAlignment="center"
                android:layout_marginEnd="0.5dp"
                style="@style/table_row_item"/>
            <TextView
                android:id="@+id/tvCurrentVersion"
                android:background="@color/black"
                android:layout_width="0dp"
                android:layout_marginLeft="0.5dp"
                android:layout_marginRight="0.5dp"
                android:layout_column="1"
                android:text="112"
                android:layout_weight="1"
                android:textAlignment="center"
                android:layout_marginHorizontal="0.5dp"
                style="@style/table_row_item"/>
            <TextView
                android:id="@+id/tvLatestVersion"
                android:background="@color/black"
                android:layout_width="0dp"
                android:baselineAligned="false"
                android:layout_column="2"
                android:text="113"
                android:layout_weight="1"
                android:textAlignment="center"
                android:layout_marginStart="0.5dp"
                style="@style/table_row_item"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
