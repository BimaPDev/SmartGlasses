            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_gps"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/img_gps"
            android:tag="binding_2"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:background="@drawable/bg_switch"
        android:padding="@dimen/_1sdp"
        android:layout_width="@dimen/_182sdp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/my_app_bar"
        app:layout_constraintTop_toBottomOf="@+id/my_app_bar">
        <TextView
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/txtDashboard"
            android:tag="binding_3"
            android:background="@drawable/bg_dashboard_selected"
            android:padding="@dimen/_5sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:text="Dash"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold"
            android:id="@+id/txtMap"
            android:tag="binding_4"
            android:background="@drawable/bg_map_unselected"
            android:padding="@dimen/_6sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:text="Map"
            android:textAlignment="center"/>
