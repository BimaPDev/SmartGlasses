            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/btnDeleteAlertMarker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/redlight_cam"
                android:textAlignment="center"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/llAddMark"
            android:tag="binding_25"
            android:background="@drawable/bg_map_alert_button"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add"
                android:textAlignment="center"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/btnAddUserMarker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_mark"
                android:textAlignment="center"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/llDeleteUserMark"
            android:tag="binding_26"
            android:background="@drawable/bg_map_alert_button"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textAlignment="center"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/btnDeleteUserMarker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_user_mark"
                android:textAlignment="center"/>
