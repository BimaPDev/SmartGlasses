            android:id="@+id/llAlertNameSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="@+id/imgMarkerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgMarkerIcon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txtMarkerType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_camera"/>
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250m"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/white"
            android:id="@+id/txtLimitSpeed"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
