                    android:layout_height="@dimen/_40sdp"
                    android:layout_margin="@dimen/_3sdp"
                    android:layout_weight="1">
                    <ImageView
                        android:tag="binding_15"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"/>
                    <TextView
                        android:textSize="@dimen/_11sdp"
                        android:textColor="@color/black"
                        android:tag="binding_16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gotham_regular"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:tag="binding_17"
                    android:visibility="gone"
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="2">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/llReceiveMode"
                        android:tag="binding_18"
                        android:background="@drawable/bg_band_alert_mute"
                        android:clickable="true"
                        android:layout_width="0sp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_margin="@dimen/_3sdp"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:tag="binding_19"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gotham_regular"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:tag="binding_20"
                    android:visibility="visible"
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="2">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/llKBlockMute"
                        android:tag="binding_21"
                        android:background="@drawable/bg_mute_enabled"
                        android:visibility="invisible"
                        android:layout_width="0sp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_margin="@dimen/_3sdp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_mute"/>
                            <TextView
                                android:textSize="@dimen/_11sdp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/block"
                                android:fontFamily="@font/gotham_regular"
                                android:layout_marginStart="@dimen/_3sdp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="K-Block"
                            android:fontFamily="@font/gotham_regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/llMuteMemory"
                        android:tag="binding_22"
                        android:background="@drawable/bg_band_alert_mute"
                        android:clickable="true"
                        android:layout_width="0sp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_margin="@dimen/_3sdp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_mute"
                                android:textAlignment="center"/>
                            <TextView
                                android:textSize="@dimen/_11sdp"
                                android:textColor="@color/black"
                                android:tag="binding_23"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:fontFamily="@font/gotham_regular"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mute_mem_"
                            android:fontFamily="@font/gotham_regular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
