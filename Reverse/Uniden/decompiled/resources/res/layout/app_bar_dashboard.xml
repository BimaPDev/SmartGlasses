        android:id="@+id/linearLayout2"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/imgGpsIcon">
        <LinearLayout
            android:gravity="center"
