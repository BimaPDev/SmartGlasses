                            android:id="@+id/imgBandDirection"
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            android:layout_marginTop="10dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/low_grey"/>
                        <TextView
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:id="@+id/txtDetectedBand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="@+id/imgBandDirection"
                            app:layout_constraintStart_toStartOf="@+id/imgBandDirection"
                            app:layout_constraintTop_toBottomOf="@+id/imgBandDirection"/>
                        <ImageView
                            android:tag="binding_13"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="0x7f080114"
                            android:scaleType="fitCenter"
                            android:layout_marginStart="5dp"
                            app:layout_constraintBottom_toBottomOf="@+id/txtDetectedBand"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintHeight="@+id/txtDetectedBand"
                            app:layout_constraintStart_toEndOf="@+id/txtDetectedBand"
                            app:layout_constraintTop_toTopOf="@+id/txtDetectedBand"/>
                        <TextView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/frequency_text"
                            android:gravity="center"
                            android:id="@+id/textBandFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_10sdp"
                            app:layout_constraintBottom_toTopOf="@+id/imgBandRSSILevel"
                            app:layout_constraintEnd_toEndOf="@+id/txtDetectedBand"
                            app:layout_constraintStart_toStartOf="@+id/txtDetectedBand"
                            app:layout_constraintTop_toBottomOf="@+id/txtDetectedBand"/>
                        <ImageView
