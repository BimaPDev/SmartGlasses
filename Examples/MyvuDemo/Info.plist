<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.myvu.demo.spotify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myvudemo</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to the Claude Code bridge running on your laptop, to stream it onto the glasses.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to notice when you arrive at a saved place, so the list for that place can appear on your glasses.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Used to notice when you arrive at a saved place even while the app is closed, so the list for that place can appear on your glasses.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
